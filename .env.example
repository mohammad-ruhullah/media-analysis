# ============================================================
# Media Analysis System - environment template
# Copy to .env and fill in. NEVER commit .env
# ============================================================

# --- Database (Neon Postgres, pooled connection) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Direct (non-pooled) URL, used by migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Super admin seed (created on first migration) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Administrator

# --- Google Gemini (highlight draft) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (cloud Whisper transcription) ---
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Cloudflare R2 (thumbnails/keyframes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media-analysis
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public base URL for reading objects (r2.dev or custom domain)
R2_PUBLIC_BASE_URL=

# --- Pipeline worker ---
# Seconds between polls for new youtube links (GitHub Actions schedule) 
POLL_BATCH_SIZE=3
WHISPER_MAX_SECONDS_PER_VIDEO=14400
SCENE_MIN_LEN_SECONDS=2
KEYFRAME_HEIGHT=480